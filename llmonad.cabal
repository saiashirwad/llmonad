cabal-version:      3.4
name:               llmonad
version:            0.2.0.0
synopsis:           A Type-Safe, Composable Haskell DSL for Large Language Models
description:        LLMonad provides an elegant, expressive Haskell Domain-Specific Language
                    for interacting with Large Language Models built on effectful. Supports OpenAI,
                    Anthropic, DeepSeek, OpenRouter, and Ollama backends, type-driven structured
                    output extraction with automatic self-correction retries, and autonomous ReAct tool agents.
license:            MIT
license-file:       LICENSE
author:             Sai Ashirwad
maintainer:         saiashirwadr@gmail.com
category:           Language, AI, Natural Language Processing
build-type:         Simple
extra-doc-files:    CHANGELOG.md, README.md

common warnings
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints
    default-extensions:
        DataKinds,
        DeriveAnyClass,
        DeriveGeneric,
        DerivingStrategies,
        FlexibleContexts,
        FlexibleInstances,
        GADTs,
        GeneralizedNewtypeDeriving,
        LambdaCase,
        MultiParamTypeClasses,
        OverloadedStrings,
        RecordWildCards,
        ScopedTypeVariables,
        TypeApplications,
        TypeFamilies,
        TypeOperators,
        UndecidableInstances
    default-language: GHC2021

library
    import:           warnings
    exposed-modules:
        LLMonad
        LLMonad.Core
        LLMonad.Types
        LLMonad.Error
        LLMonad.Provider
        LLMonad.Providers.OpenAICompatible
        LLMonad.Providers.Anthropic
        LLMonad.Interpreter.HTTP
        LLMonad.Interpreter.Mock
        LLMonad.Middleware.Cache
        LLMonad.Middleware.Trace
        LLMonad.Middleware.RateLimit
        LLMonad.Schema
        LLMonad.Structured
        LLMonad.API
        LLMonad.Prompt
        LLMonad.Streaming
        LLMonad.Tools
        LLMonad.Tools.Coding
        LLMonad.Subagent
        LLMonad.Agent
        LLMonad.World
        LLMonad.World.Types
        LLMonad.World.Local
        LLMonad.World.Worktree
        LLMonad.World.Memory
        LLMonad.Journal
        LLMonad.Journal.Types
        LLMonad.Journal.File
        LLMonad.Journal.Memory
        LLMonad.Journal.Replay
        LLMonad.TUI
        LLMonad.TH
        LLMonad.TH.QuasiQuoter
        LLMonad.Internal.Http
        LLMonad.Internal.SSE
        LLMonad.Internal.Extract
        LLMonad.Internal.GlobalManager
    build-depends:
        base >= 4.16 && < 5,
        effectful-core >= 2.5 && < 2.7,
        effectful >= 2.5 && < 2.7,
        aeson >= 2.0 && < 3.0,
        bytestring >= 0.10 && < 0.13,
        text >= 1.2 && < 2.2,
        http-client >= 0.7 && < 0.9,
        http-client-tls >= 0.3 && < 0.4,
        http-types >= 0.12 && < 0.13,
        template-haskell >= 2.19 && < 2.22,
        containers >= 0.6 && < 0.8,
        unordered-containers >= 0.2 && < 0.3,
        vector >= 0.12 && < 0.14,
        scientific >= 0.3 && < 0.4,
        case-insensitive >= 1.2 && < 1.3,
        time >= 1.9 && < 2.0,
        directory >= 1.3.6 && < 1.4,
        filepath >= 1.4 && < 1.6,
        process >= 1.6 && < 1.7,
        temporary >= 1.3 && < 1.4,
        async >= 2.2 && < 2.3,
        stm >= 2.5 && < 2.6,
        brick >= 2.0 && < 3.0,
        vty >= 6.0 && < 7.0,
        vty-unix >= 0.1 && < 0.3,
        vty-crossplatform >= 0.1 && < 0.3,
        Diff >= 0.4 && < 1.1
    hs-source-dirs:   src
    default-language: GHC2021

executable llmonad
    import:           warnings
    main-is:          Main.hs
    build-depends:
        base >= 4.16 && < 5,
        llmonad,
        effectful-core >= 2.5 && < 2.7,
        effectful >= 2.5 && < 2.7,
        aeson >= 2.0 && < 3.0,
        text >= 1.2 && < 2.2,
        bytestring >= 0.10 && < 0.13,
        containers >= 0.6 && < 0.8
    hs-source-dirs:   app
    default-language: GHC2021

executable llmonad-tui
    import:           warnings
    main-is:          TUI.hs
    build-depends:
        base >= 4.16 && < 5,
        llmonad,
        effectful-core >= 2.5 && < 2.7,
        effectful >= 2.5 && < 2.7,
        aeson >= 2.0 && < 3.0,
        text >= 1.2 && < 2.2,
        bytestring >= 0.10 && < 0.13,
        containers >= 0.6 && < 0.8,
        directory >= 1.3.6 && < 1.4,
        filepath >= 1.4 && < 1.6,
        brick >= 2.0 && < 3.0,
        vty >= 6.0 && < 7.0,
        vty-crossplatform >= 0.1 && < 0.3,
        async >= 2.2 && < 2.3
    hs-source-dirs:   app
    default-language: GHC2021

test-suite llmonad-test
    import:           warnings
    default-language: GHC2021
    ghc-options:      -threaded -rtsopts
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:
        LLMonad.SchemaSpec
        LLMonad.SSESpec
        LLMonad.HttpSpec
        LLMonad.ExtractSpec
        LLMonad.CoreSpec
        LLMonad.OpenAICompatSpec
        LLMonad.AnthropicSpec
        LLMonad.MockSpec
        LLMonad.AgentSpec
        LLMonad.CurriedAPISpec
        LLMonad.StructuredSpec
        LLMonad.PromptSpec
        LLMonad.StreamingSpec
        LLMonad.THSpec
        LLMonad.E2ETier3Spec
        LLMonad.E2ETier4Spec
        LLMonad.ChallengerSpec
        LLMonad.WorldSpec
        LLMonad.WorldAdversarialSpec
        LLMonad.JournalSpec
        LLMonad.CodingToolsSpec
        LLMonad.SubagentSpec
        LLMonad.CodingToolsAdversarialSpec
        LLMonad.TUISpec
        LLMonad.TUIAdversarialSpec
        LLMonad.E2ESpec
        LLMonad.Batch1AdversarialSpec
        LLMonad.Batch2AdversarialSpec
        LLMonad.Batch2ChallengerStressSpec
        LLMonad.Batch2ChallengerSpec
        LLMonad.Batch3AdversarialSpec
        LLMonad.Batch3ChallengerStressSpec
        LLMonad.Batch3ChallengerSpec
        LLMonad.Mock
    build-depends:
        base >= 4.16 && < 5,
        llmonad,
        effectful-core >= 2.5 && < 2.7,
        effectful >= 2.5 && < 2.7,
        aeson >= 2.0 && < 3.0,
        text >= 1.2 && < 2.2,
        bytestring >= 0.10 && < 0.13,
        containers >= 0.6 && < 0.8,
        vector >= 0.12 && < 0.14,
        scientific >= 0.3 && < 0.4,
        time >= 1.9 && < 2.0,
        directory >= 1.3.6 && < 1.4,
        filepath >= 1.4 && < 1.6,
        process >= 1.6 && < 1.7,
        temporary >= 1.3 && < 1.4,
        async >= 2.2 && < 2.3,
        http-client >= 0.7 && < 0.9,
        case-insensitive >= 1.2 && < 1.3,
        brick >= 2.0 && < 3.0,
        vty >= 6.0 && < 7.0,
        hspec >= 2.10 && < 2.12,
        hspec-core >= 2.10 && < 2.12,
        QuickCheck >= 2.14 && < 2.16
