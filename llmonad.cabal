cabal-version:      3.4
name:               llmonad
version:            0.2.0.0
synopsis:           A Type-Safe, Composable Haskell DSL for Large Language Models
description:        LLMonad provides an elegant, expressive Haskell Domain-Specific Language
                    for interacting with Large Language Models. Supports OpenAI, Anthropic,
                    DeepSeek, OpenRouter, and Ollama backends, type-driven structured output extraction
                    with automatic self-correction retries, and autonomous ReAct tool agents.
license:            MIT
license-file:       LICENSE
author:             Sai Ashirwad
maintainer:         saiashirwadr@gmail.com
category:           Language, AI, Natural Language Processing
build-type:         Simple
extra-doc-files:    CHANGELOG.md, README.md

common warnings
    ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
    default-extensions:
        LambdaCase,
        OverloadedStrings,
        RecordWildCards,
        DeriveGeneric,
        DeriveAnyClass,
        ScopedTypeVariables

library
    import:           warnings
    exposed-modules:
        LLMonad
        LLMonad.Core
        LLMonad.Types
        LLMonad.Provider
        LLMonad.Client
        LLMonad.Schema
        LLMonad.Structured
        LLMonad.Tools
        LLMonad.Agent
        LLMonad.Prompt
        LLMonad.Streaming
    build-depends:
        base >= 4.16 && < 5,
        aeson >= 2.0 && < 3.0,
        bytestring >= 0.10 && < 0.13,
        text >= 1.2 && < 2.2,
        http-client >= 0.7 && < 0.8,
        http-client-tls >= 0.3 && < 0.4,
        http-types >= 0.12 && < 0.13,
        mtl >= 2.2 && < 2.4,
        transformers >= 0.5 && < 0.7,
        containers >= 0.6 && < 0.8,
        unordered-containers >= 0.2 && < 0.3,
        vector >= 0.12 && < 0.14,
        scientific >= 0.3 && < 0.4,
        case-insensitive >= 1.2 && < 1.3
    hs-source-dirs:   lib
    default-language: GHC2021

executable llmonad
    import:           warnings
    main-is:          Main.hs
    build-depends:
        base >= 4.16 && < 5,
        llmonad,
        aeson >= 2.0 && < 3.0,
        text >= 1.2 && < 2.2,
        bytestring >= 0.10 && < 0.13,
        containers >= 0.6 && < 0.8
    hs-source-dirs:   app
    default-language: GHC2021

test-suite llmonad-test
    import:           warnings
    default-language: GHC2021
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    build-depends:
        base >= 4.16 && < 5,
        llmonad,
        aeson >= 2.0 && < 3.0,
        text >= 1.2 && < 2.2,
        bytestring >= 0.10 && < 0.13,
        containers >= 0.6 && < 0.8

executable example-basic-chat
    import:           warnings
    default-language: GHC2021
    main-is:          01_BasicChat.hs
    hs-source-dirs:   examples
    build-depends:
        base >= 4.16 && < 5,
        llmonad,
        text >= 1.2 && < 2.2

executable example-structured
    import:           warnings
    default-language: GHC2021
    main-is:          02_StructuredOutput.hs
    hs-source-dirs:   examples
    build-depends:
        base >= 4.16 && < 5,
        llmonad,
        aeson >= 2.0 && < 3.0,
        text >= 1.2 && < 2.2

executable example-agent
    import:           warnings
    default-language: GHC2021
    main-is:          03_AgentWithTools.hs
    hs-source-dirs:   examples
    build-depends:
        base >= 4.16 && < 5,
        llmonad,
        aeson >= 2.0 && < 3.0,
        text >= 1.2 && < 2.2

executable example-multiturn
    import:           warnings
    default-language: GHC2021
    main-is:          04_MultiTurnConversation.hs
    hs-source-dirs:   examples
    build-depends:
        base >= 4.16 && < 5,
        llmonad,
        text >= 1.2 && < 2.2
