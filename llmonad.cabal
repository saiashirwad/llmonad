cabal-version:   3.4
name:            llmonad
version:         0.3.0.0
license:         MIT
license-file:    LICENSE
maintainer:      saiashirwadr@gmail.com
author:          Sai Ashirwad
synopsis:
    A Type-Safe, Composable Haskell DSL for Large Language Models

description:
    LLMonad provides an elegant, expressive Haskell Domain-Specific Language
    for interacting with Large Language Models built on effectful. Supports OpenAI,
    Anthropic, DeepSeek, OpenRouter, and Ollama backends, type-driven structured
    output extraction with automatic self-correction retries, and autonomous ReAct tool agents.

category:        Language, AI, Natural Language Processing
build-type:      Simple
extra-doc-files:
    CHANGELOG.md
    README.md

library
    exposed-modules:
        LLMonad
        LLMonad.Core
        LLMonad.Types
        LLMonad.Error
        LLMonad.Provider
        LLMonad.Providers.OpenAICompatible
        LLMonad.Providers.Anthropic
        LLMonad.Interpreter.HTTP
        LLMonad.Interpreter.Mock
        LLMonad.Middleware
        LLMonad.Middleware.Cache
        LLMonad.Middleware.Trace
        LLMonad.Middleware.RateLimit
        LLMonad.Schema
        LLMonad.Structured
        LLMonad.API
        LLMonad.Prompt
        LLMonad.Streaming
        LLMonad.Tools
        LLMonad.Tools.Coding
        LLMonad.Agent
        LLMonad.Model
        LLMonad.Workflow
        LLMonad.World
        LLMonad.World.Types
        LLMonad.World.Local
        LLMonad.World.Worktree
        LLMonad.World.Memory
        LLMonad.Journal
        LLMonad.Journal.Types
        LLMonad.Journal.File
        LLMonad.Journal.Memory
        LLMonad.Journal.Replay
        LLMonad.TH
        LLMonad.TH.QuasiQuoter
        LLMonad.Internal.Http
        LLMonad.Internal.SSE
        LLMonad.Internal.Extract
        LLMonad.Internal.GlobalManager

    hs-source-dirs:     src
    default-language:   GHC2021
    default-extensions:
        DataKinds DeriveAnyClass DeriveGeneric DerivingStrategies
        FlexibleContexts FlexibleInstances GADTs GeneralizedNewtypeDeriving
        LambdaCase MultiParamTypeClasses OverloadedStrings RecordWildCards
        ScopedTypeVariables TypeApplications TypeFamilies TypeOperators
        UndecidableInstances

    ghc-options:
        -Wall -Wcompat -Widentities -Wincomplete-record-updates
        -Wincomplete-uni-patterns -Wmissing-home-modules -Wpartial-fields
        -Wredundant-constraints

    build-depends:
        base >=4.16 && <5,
        effectful-core >=2.5 && <2.7,
        effectful >=2.5 && <2.7,
        aeson >=2.0 && <3,
        bytestring >=0.10 && <0.13,
        text >=1.2 && <2.2,
        http-client >=0.7 && <0.9,
        http-client-tls >=0.3 && <0.4,
        http-types >=0.12 && <0.13,
        template-haskell >=2.19 && <2.24,
        containers >=0.6 && <0.8,
        unordered-containers >=0.2 && <0.3,
        vector >=0.12 && <0.14,
        scientific >=0.3 && <0.4,
        case-insensitive >=1.2 && <1.3,
        time >=1.9 && <2,
        directory >=1.3.6 && <1.4,
        filepath >=1.4 && <1.6,
        process >=1.6 && <1.7,
        temporary >=1.3 && <1.4,
        async >=2.2 && <2.3,
        Diff >=0.4 && <1.1

